<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/povtorBackground</item>
        <item name="colorPrimaryDark">@color/povtorBackground</item>
        <item name="colorAccent">@color/povtorAccent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/povtorBackground</item>
        <item name="android:navigationBarColor">@color/povtorBackground</item>
        <item name="android:windowBackground">@color/povtorBackground</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/povtorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/povtor_mark</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/povtorBackground</item>
        <item name="android:navigationBarColor">@color/povtorBackground</item>
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
